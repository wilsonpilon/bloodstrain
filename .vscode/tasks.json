{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Bloodstrain: build e pacote",
			"type": "shell",
			"command": "powershell.exe",
			"args": [
				"-NoProfile",
				"-ExecutionPolicy",
				"Bypass",
				"-File",
				"${workspaceFolder}\\scripts\\build.ps1"
			],
			"isBackground": false,
			"problemMatcher": [],
			"group": "build"
		},
		{
			"label": "Bloodstrain: release inaugural (nao repetir)",
			"type": "shell",
			"command": "powershell.exe",
			"args": [
				"-NoProfile",
				"-ExecutionPolicy",
				"Bypass",
				"-File",
				"${workspaceFolder}\\scripts\\build.ps1",
				"-InitialRelease"
			],
			"problemMatcher": []
		},
		{
			"label": "Bloodstrain: build e pacote (validar openMSX)",
			"type": "shell",
			"command": "powershell.exe",
			"args": [
				"-NoProfile",
				"-ExecutionPolicy",
				"Bypass",
				"-File",
				"${workspaceFolder}\\scripts\\build.ps1",
				"-SmokeTest",
				"-DosFilesPath",
				"${workspaceFolder}\\MSXgl\\tools\\build\\DOS",
				"-BootTemplatePath",
				"${workspaceFolder}\\msxDiskUtil\\msxdos.dsk"
			],
			"isBackground": false,
			"problemMatcher": [],
			"group": "build"
		}
	]
}